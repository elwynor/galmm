/* HVSMM.rc - Windows version resource for the Menu Magician module DLL.     */
/* Keep the numbers in step with HVSMM_VER_* and HVSMM_VERSION (HVSMMDEF.H). */

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
