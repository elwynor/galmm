 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Elwynor Technologies"
            VALUE "FileDescription",  "Menu Magician - online menu tree editor for The Major BBS v10"
            VALUE "FileVersion",      "1.4.0.0"
            VALUE "InternalName",     "HVSMM"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Elwynor Technologies. Originally (c) 1993-1996 High Velocity Software, Inc."
            VALUE "OriginalFilename", "HVSMM.DLL"
            VALUE "ProductName",      "Menu Magician"
            VALUE "ProductVersion",   "1.4.0"
            VALUE "Comments",         "Converted for The Major BBS v10 by Mark Laudenbach - https://github.com/laudenbachm"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END